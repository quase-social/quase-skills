# Ignore everything by default
*

# Track marketplace config
!.claude-plugin/
!.claude-plugin/**

# Track plugins directory
!plugins/
!plugins/**

# Track root files (new root files need their own allow-rule)
!.gitignore
!README.md
!CLAUDE.md
!AGENTS.md

# Python bytecode (deny even inside allowed plugins/**)
__pycache__/
*.pyc

# IDE files
.idea/
.vscode/

# OS files
.DS_Store
Thumbs.db
